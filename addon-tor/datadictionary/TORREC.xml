<?xml version="1.0" encoding="ISO-8859-1" ?>
<!--
  TORREC - recebimento da compra (23/11/2026, etapa 2 do plano "Entrada com enderecamento").
  V1: um recebimento por nota + conferencia (decisao 23/11/2026); agrupar notas (TORRXN) fica para depois.
  SITUACAO: PE = conferida pela Torre, aguardando confirmacao; AP = aprovado (compra confirmada); RC = devolvido
  para recontagem. ORIGEM: T = Aprovar da Torre; S = confirmada direto no Sankhya (evento). Plano B, 25/11/2026.
  Unicidade (NUNOTA, NUCONF) garantida pelo servico RecebimentoSP.
-->
<metadados xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="../.gradle/metadados.xsd">
    <table name="TORREC" sequenceType="A" sequenceField="NUREC">
        <description>Torre de Opera&#231;&#227;o - Recebimento</description>
        <primaryKey>
            <field name="NUREC"/>
        </primaryKey>
        <instances>
            <instance name="RecebimentoTorre">
                <description>Torre de Opera&#231;&#227;o - Recebimento</description>
            </instance>
        </instances>
        <fields>
            <field name="NUREC" dataType="INTEIRO" allowSearch="S" visibleOnSearch="S" required="S">
                <description>N&#250;mero do Recebimento</description>
            </field>
            <field name="CODEMP" dataType="PESQUISA" targetInstance="Empresa" targetField="CODEMP" targetType="INTEIRO" allowSearch="S" visibleOnSearch="S">
                <description>Empresa</description>
            </field>
            <field name="NUNOTA" dataType="INTEIRO" allowSearch="S" visibleOnSearch="S" required="S">
                <description>N&#250;mero &#218;nico da Compra</description>
            </field>
            <field name="NUCONF" dataType="INTEIRO" allowSearch="S" visibleOnSearch="S" required="S">
                <description>N&#250;mero da Confer&#234;ncia</description>
            </field>
            <field name="SITUACAO" dataType="TEXTO" size="2" allowSearch="S" visibleOnSearch="S" required="S">
                <description>Situa&#231;&#227;o</description>
            </field>
            <field name="CODUSUAPROV" dataType="PESQUISA" targetInstance="Usuario" targetField="CODUSU" targetType="INTEIRO" allowSearch="S" visibleOnSearch="S">
                <description>Aprovado Por</description>
            </field>
            <field name="DHAPROV" dataType="DATA_HORA" allowSearch="S" visibleOnSearch="S">
                <description>Data e Hora da Aprova&#231;&#227;o</description>
            </field>
            <field name="CODUSUDEV" dataType="PESQUISA" targetInstance="Usuario" targetField="CODUSU" targetType="INTEIRO" allowSearch="S" visibleOnSearch="S">
                <description>Devolvido Por</description>
            </field>
            <field name="DHDEV" dataType="DATA_HORA" allowSearch="S" visibleOnSearch="S">
