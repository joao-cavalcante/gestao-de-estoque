            </field>
            <field name="MOTIVODEV" dataType="TEXTO" size="400" allowSearch="S" visibleOnSearch="S">
                <description>Motivo da Devolu&#231;&#227;o</description>
            </field>
            <field name="ORIGEM" dataType="TEXTO" size="1" allowSearch="S" visibleOnSearch="S">
                <description>Confirmado Por</description>
            </field>
        </fields>
    </table>
</metadados>
