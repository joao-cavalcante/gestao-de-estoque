# WMS produção — copie para  ../.env  (na raiz do repo, ao lado do docker-compose.prod.yml)
# e preencha. NÃO commite o .env preenchido (já está no .gitignore).

# ── Postgres (container wms-db) ──────────────────────────────────────────
# Superusuário do banco — usado só pelas migrações/seed.
POSTGRES_PASSWORD=troque-esta-senha-forte

# ── Runtime do backend ──────────────────────────────────────────────────
# Senha do role de aplicação wms_app (o migrate.sh faz ALTER ROLE pra este valor).
WMS_DB_PASSWORD=troque-esta-outra-senha-forte
WMS_DB_POOL_SIZE=20

# Chave AES-256 (base64 de 32 bytes) que cifra as credenciais Sankhya no banco.
# O valor abaixo é a CHAVE DE DEV FIXA do código — as credenciais no seed
# (deploy/seed/01-tenants-users.sql) foram cifradas com ela. Funciona na hora.
# Pra rotacionar depois: gere uma nova, decifre e re-cifre as credenciais.
#   openssl rand -base64 32
WMS_CREDENTIALS_KEY=ZGV2LW9ubHkta2V5LXRyb3F1ZS1lbS1wcm9kdWNhbyE=

# Segredo de assinatura dos JWT (qualquer string longa aleatória).
#   openssl rand -hex 32
WMS_JWT_SECRET=troque-por-uma-string-aleatoria-longa

# ── Painel Master (administração da plataforma) — ver deploy/RUNBOOK-master.md ──
# Chave PRÓPRIA dos tokens Master: obrigatória, 32+ caracteres, DIFERENTE do WMS_JWT_SECRET.
# Vazia/curta/igual = Painel Master desligado (503); o WMS dos clientes segue normal.
#   openssl rand -hex 32
WMS_MASTER_JWT_SECRET=
# Segundo fator (TOTP) obrigatório no login Master. Só desligar (false) junto com WMS_MASTER_REDES_PERMITIDAS.
WMS_MASTER_MFA_OBRIGATORIO=true
# Redes de onde o Painel Master responde (CIDR, vírgula). Vazio = qualquer rede. Ex.: faixa da VPN 10.8.0.0/24
WMS_MASTER_REDES_PERMITIDAS=
# Proxies cujo X-Real-IP é aceito como IP do cliente (o nginx do wms-frontend). Faixa da rede docker do compose:
#   docker network inspect wms_default --format '{{(index .IPAM.Config 0).Subnet}}'
WMS_PROXIES_CONFIAVEIS=

# ── Auto-liberação de corte por peso (opcional) ─────────────────────────
# Usuário/senha Sankhya com permissão de liberar corte. Sem isto, o corte
# por divergência de peso cai em liberação manual (não quebra nada).
LIBERADOR_USUARIO=
LIBERADOR_SENHA=
